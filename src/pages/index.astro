---
import Layout from "../layouts/Layout.astro";
import NavbarComponent from "../components/NavbarComponent/NavbarComponent.tsx";
import HomePage from "./HomePage/_HomePage.tsx";
import AboutPage from "./AboutPage/_AboutPage.tsx";
import GalleryPage from "./GalleryPage/_GalleryPage.tsx";
import ContactPage from "./ContactPage/_ContactPage.tsx";
import FooterComponent from "../components/FooterComponent/FooterComponent.tsx";
---

<Layout>
  <main>
    <NavbarComponent client:load />
    <HomePage client:visible />
    <AboutPage client:visible />
    <GalleryPage client:visible />
    <ContactPage client:visible />
    <FooterComponent client:visible />
  </main>
</Layout>

<style>
  /* Global smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Ensure sections have proper spacing */
  main > * + * {
    margin-top: 0;
  }
</style>
